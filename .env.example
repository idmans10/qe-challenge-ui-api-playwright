# Copy to .env to override defaults. All values below are PUBLIC demo values
# published by the systems under test; never put real credentials here.

# SauceDemo (https://www.saucedemo.com) - credentials shown on its login page
UI_BASE_URL=https://www.saucedemo.com
SAUCE_PASSWORD=secret_sauce

# Restful-Booker (https://restful-booker.herokuapp.com/apidoc) - documented demo admin
API_BASE_URL=https://restful-booker.herokuapp.com
BOOKER_USERNAME=admin
BOOKER_PASSWORD=password123
